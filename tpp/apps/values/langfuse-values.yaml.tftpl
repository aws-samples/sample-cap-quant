langfuse:
  nextauth:
    # Port-forward access for now; switch to the official URL once an Ingress is exposed.
    # This binds the *local* port, so it must match the environment's port block in
    # scripts/tpp-tunnels.sh (dev 3010, prod 4010) or Langfuse auth breaks on redirect.
    url: ${langfuse_nextauth_url}
    secret:
      value: "" # Leave empty: auto-generated on first install and persisted in the <release>-app secret
  salt:
    value: ""
  encryptionKey:
    value: ""

  serviceAccount:
    create: true
    name: langfuse # Must match the infra IRSA subject langfuse/langfuse
    annotations:
      eks.amazonaws.com/role-arn: ${langfuse_role_arn}

  # Empty in dev (schedule anywhere); prod pins web/worker to the observability pool
  nodeSelector: ${jsonencode(node_selector)}
  web:
    replicas: ${web_replicas}
  worker:
    replicas: ${worker_replicas}

  # headless init: auto-creates org/project/API keys on first startup (values come from the <prefix>/langfuse secret)
  additionalEnvFrom:
    - secretRef:
        name: langfuse-init

  # The chart's individual PostgreSQL fields pass the raw password through to
  # Prisma. Use the URL-encoded connection string rendered by External Secrets
  # instead; DIRECT_URL is used by Prisma migrations.
  additionalEnv:
    - name: DATABASE_URL
      valueFrom:
        secretKeyRef:
          name: langfuse-postgres
          key: database_url
    - name: DIRECT_URL
      valueFrom:
        secretKeyRef:
          name: langfuse-postgres
          key: database_url

postgresql:
  deploy: false
  host: ${rds_address}
  auth:
    username: tpp
    database: langfuse
    existingSecret: langfuse-postgres
    secretKeys:
      userPasswordKey: password

redis:
  deploy: false
  host: ${redis_endpoint}
  port: 6379
  tls:
    enabled: ${redis_tls}
%{ if redis_tls ~}
  # prod ElastiCache: AUTH token synced by External Secrets from <prefix>/redis-queue into the langfuse-redis Secret
  auth:
    enabled: true
    username: default
    existingSecret: langfuse-redis
    existingSecretPasswordKey: password
%{ else ~}
  auth:
    enabled: false # dev ElastiCache has AUTH disabled
%{ endif ~}

clickhouse:
  deploy: false # Skip the chart's alpha operator; self-managed single-node StatefulSet (langfuse.tf)
  host: clickhouse
  auth:
    username: default
    existingSecret: langfuse-clickhouse
    existingSecretKey: password
  migration:
    autoMigrate: true
    ssl: false
  # Single-node ClickHouse: disable cluster mode (otherwise migrations use ON CLUSTER/ReplicatedMergeTree, which requires Keeper)
  cluster:
    enabled: false

s3:
  deploy: false
  bucket: ${bucket}
  region: ${region}
  forcePathStyle: false
  # Leave accessKeyId/secretAccessKey empty => SDK credential chain uses IRSA
